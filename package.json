{
  "name": "future-frame",
  "version": "1.0.0",
  "description": "Autonomous Video Clipping & Semantic Temporal Extraction Agent",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev:server": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "rimraf dist && tsc",
    "start:server": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "video-clipping",
    "gemini-multimodal",
    "ffmpeg",
    "bullmq"
  ],
  "author": "Future Foundation",
  "license": "ISC",
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/multipart": "^10.1.2",
    "@fastify/sensible": "^6.0.6",
    "@google/genai": "^2.27.0",
    "bullmq": "^6.3.11",
    "dotenv": "^18.0.5",
    "fastify": "^5.12.5",
    "ioredis": "^6.0.0",
    "pino": "^10.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@vitest/coverage-v8": "^4.1.11",
    "pino-pretty": "^13.2.0",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
